{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mql5-codegraph.dev/contracts/reference-corpus-v1.schema.json",
  "title": "MQL5 CodeGraph reference corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "corpus_fingerprint",
    "configuration",
    "sources",
    "counts",
    "files",
    "complete"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "corpus_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_version",
        "extractors",
        "max_pdf_bytes",
        "max_pages_per_source",
        "max_pages_per_section"
      ],
      "properties": {
        "normalization_version": {"type": "string", "minLength": 1},
        "extractors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure", "text"],
          "properties": {
            "structure": {"$ref": "#/$defs/extractor"},
            "text": {"$ref": "#/$defs/extractor"}
          }
        },
        "max_pdf_bytes": {"type": "integer", "minimum": 1},
        "max_pages_per_source": {"type": "integer", "minimum": 1},
        "max_pages_per_section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "pages", "sections", "warnings"],
      "properties": {
        "documents": {"type": "integer", "minimum": 1},
        "pages": {"type": "integer", "minimum": 1},
        "sections": {"type": "integer", "minimum": 1},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    },
    "complete": {"const": true}
  },
  "$defs": {
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_id",
        "filename",
        "title",
        "authority",
        "role",
        "sha256",
        "byte_size",
        "page_count",
        "section_count",
        "page_states",
        "warnings"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "filename": {"type": "string", "pattern": "^[^/\\\\]+\\.pdf$"},
        "title": {"type": "string", "minLength": 1},
        "authority": {
          "enum": ["normative", "explanatory", "specialist", "unclassified"]
        },
        "role": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "page_count": {"type": "integer", "minimum": 1},
        "section_count": {"type": "integer", "minimum": 1},
        "page_states": {"type": "object"},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
